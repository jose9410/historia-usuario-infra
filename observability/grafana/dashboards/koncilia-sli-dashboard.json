{
  "annotations": { "list": [] },
  "description": "Koncilia Microservices — SLI/SLO Observability Dashboard.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SLI — Service Level Indicators",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "description": "% of requests returning 2xx/3xx. SLO: ≥ 99.5%",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100, "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 95   },
            { "color": "green",  "value": 99.5 }
          ]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "SLI 1 — Availability (%)",
      "type": "gauge",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
        "expr": "100 * sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"2..|3..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
        "legendFormat": "Availability",
        "refId": "A",
        "instant": false
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "description": "95th percentile HTTP response time. SLO: P95 < 500ms",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "fillOpacity": 15, "gradientMode": "opacity",
            "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5,
            "showPoints": "auto", "spanNulls": false,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 300  },
            { "color": "red",    "value": 500  }
          ]},
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "SLI 2 — Latency P95 (ms)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval]))) * 1000",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval]))) * 1000",
          "legendFormat": "P50",
          "refId": "B"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "description": "% of requests returning 5xx. SLO: < 0.5%",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity",
            "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5,
            "showPoints": "auto", "spanNulls": false,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 0.1  },
            { "color": "red",    "value": 0.5  }
          ]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "SLI 3 — Error Rate (%)",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
        "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
        "legendFormat": "Error %",
        "refId": "A"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "description": "HTTP requests per second across all services.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "fillOpacity": 15, "gradientMode": "opacity",
            "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5,
            "showPoints": "auto", "spanNulls": false
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "SLI 4 — Throughput (req/s)",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
        "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
        "legendFormat": "{{job}}",
        "refId": "A"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "description": "CPU time consumed by .NET process. From process_cpu_time_seconds_total counter.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity",
            "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5,
            "showPoints": "auto", "spanNulls": false
          },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 0.5  },
            { "color": "red",    "value": 0.8  }
          ]},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "CPU Usage — .NET Process",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
        "expr": "sum by (job) (rate(process_cpu_time_seconds_total[$__rate_interval]))",
        "legendFormat": "CPU — {{job}}",
        "refId": "A"
      }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 101,
      "title": "OTel Collector Health",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "description": "Spans/metrics/logs dropped by the OTel Collector. Should stay at 0.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars", "fillOpacity": 80,
            "lineWidth": 1, "pointSize": 5,
            "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red",   "value": 1    }
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "OTel Collector — Exporter Send Failures (items/min)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
          "expr": "rate(otelcol_exporter_send_failed_spans_total[$__rate_interval]) * 60",
          "legendFormat": "Spans — {{exporter}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
          "expr": "rate(otelcol_exporter_send_failed_metric_points_total[$__rate_interval]) * 60",
          "legendFormat": "Metrics — {{exporter}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
          "expr": "rate(otelcol_exporter_send_failed_log_records_total[$__rate_interval]) * 60",
          "legendFormat": "Logs — {{exporter}}",
          "refId": "C"
        }
      ]
    }

  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["koncilia", "sli", "observability", "opentelemetry"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Koncilia — SLI/SLO Observability",
  "uid": "koncilia-sli-v1",
  "version": 3,
  "weekStart": ""
}
